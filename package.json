{
  "name": "trainllm-lite-backend",
  "version": "1.0.0",
  "description": "trainllm",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node dist/src/index.js",
    "start:prod": "node dist/src/index.js",
    "start:dev": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "npm run clean && tsc && npm run postbuild",
    "prebuild": "echo 'Starting build process...'",
    "postbuild": "echo 'Build completed successfully' && dir dist || echo 'dist directory not found'",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test-build": "node scripts/test-build.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@langchain/community": "^1.1.0",
    "@langchain/core": "^1.1.6",
    "@langchain/openai": "^1.2.0",
    "@langchain/pinecone": "^1.0.1",
    "@langchain/textsplitters": "^1.0.1",
    "@pinecone-database/pinecone": "^6.1.3",
    "@vercel/node": "^5.5.15",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "langchain": "^1.2.1",
    "multer": "^2.0.2",
    "openai": "^6.14.0",
    "zod": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}